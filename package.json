{
  "name": "shopify-ai-builder",
  "version": "0.6.2",
  "description": "Gaia-governed AI delivery platform for Shopify consultants",
  "type": "module",
  "scripts": {
    "test": "node --test \"discovery/tests/**/*.test.js\"",
    "questionnaire:render": "node discovery/scripts/render-questionnaire.js",
    "discover": "node --env-file-if-exists=.env discovery/agents/discovery/cli.js",
    "discover:prepare": "node discovery/agents/discovery/claude-code.js prepare",
    "discover:assemble": "node discovery/agents/discovery/claude-code.js assemble",
    "discover:finish": "node discovery/agents/discovery/claude-code.js finish",
    "backlog": "node discovery/agents/backlog/cli.js",
    "deck": "node discovery/agents/discovery-deck/build.js",
    "deck:check": "node discovery/agents/discovery-deck/build.js check",
    "interview": "node discovery/agents/interview/cli.js",
    "apps": "node discovery/scripts/apps.js",
    "workbook": "node discovery/agents/workbook/build.js"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "ajv": "^8.20.0"
  }
}
