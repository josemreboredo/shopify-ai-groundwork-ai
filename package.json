{
  "name": "shopify-ai-builder",
  "version": "1.0.0",
  "description": "Gaia-governed AI delivery platform for Shopify consultants",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "test": "node --test \"ai/tests/**/*.test.js\" \"frontend/app/**/*.test.js\"",
    "lint": "eslint ai frontend/app",
    "questionnaire:render": "node ai/scripts/render-questionnaire.js",
    "strategy:render": "node ai/scripts/render-strategy.js",
    "discover": "node --env-file-if-exists=.env ai/engine/cli.js",
    "discover:prepare": "node ai/engine/claude-code.js prepare",
    "discover:assemble": "node ai/engine/claude-code.js assemble",
    "discover:finish": "node ai/engine/claude-code.js finish",
    "backlog": "node ai/backlog/cli.js",
    "deck": "node ai/discovery-deck/build.js",
    "deck:check": "node ai/discovery-deck/build.js check",
    "deck:prompt": "node ai/scripts/render-deck-prompt.js",
    "reference:chapters": "node ai/scripts/render-reference-chapters.js",
    "teach:merge": "node ai/scripts/merge-teach.mjs",
    "interview": "node ai/engagement/cli.js",
    "apps": "node ai/scripts/apps.js",
    "workbook": "node ai/workbook/build.js",
    "web": "npm run dev --workspace frontend",
    "web:build": "npm run build --workspace frontend",
    "sources:check": "node ai/scripts/check-sources.mjs"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5"
  }
}
