{
  "name": "shopify-ai-builder",
  "version": "0.2.0",
  "description": "Gaia-governed AI delivery platform for Shopify consultants",
  "type": "module",
  "scripts": {
    "questionnaire": "node scripts/questionnaire/questionnaire.js",
    "generate-stories": "node scripts/generate-stories.js",
