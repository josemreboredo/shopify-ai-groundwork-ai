# Copy to .env and fill in. Never commit real values.
# Discovery tool: only needed for npm run discover (API mode). Build agents will add their own store variables.
ANTHROPIC_API_KEY=
# Only for organisation-level keys not scoped to a workspace (Console → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=

# Lead Consultant web app, local development only (frontend/README.md for Vercel variables)
DEV_LOGIN=
